# Optional local database path. No API/provider credentials are required.
# Export this variable in your shell; the app does not automatically read .env files.
AGENT_DATABASE=.agent-v3/tasks.sqlite3

# Require workspace API credentials for pilot access. Leave off only for local demos.
AGENT_AUTH_REQUIRED=1
# Optional OpenAI-compatible structured planning. Disabled unless all are configured.
# Set the real key securely in your environment settings, never commit it.
AGENT_LLM_URL=
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
AGENT_LLM_BUDGET_USD=0
AGENT_LLM_INPUT_USD_PER_MILLION=0
AGENT_LLM_OUTPUT_USD_PER_MILLION=0
